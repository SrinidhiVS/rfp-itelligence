# Copy to .env and replace placeholders with newly rotated credentials.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
RFP_MODEL_PROVIDER=auto
RFP_OLLAMA_MODEL=qwen2.5:3b
RFP_OLLAMA_BASE_URL=http://localhost:11434/v1
LANGSMITH_API_KEY=replace-with-your-langsmith-key
LANGSMITH_PROJECT=rfp-multi-agent-analysis
RFP_MAX_RETRIES=2
RFP_TRACE=true
RFP_TRACE_PATH=traces/runtime-trace.json
RFP_INDEX_PATH=output/search-index.json
RFP_EMBEDDING_MODEL=all-MiniLM-L6-v2
RFP_VECTOR_INDEX_PATH=output/search-vectors.json
RFP_FRONTEND_TIMEOUT=60
RFP_JOB_REQUEST_TIMEOUT=15
RFP_JOB_POLL_INTERVAL=1
RFP_JOB_MAX_WAIT=1800
